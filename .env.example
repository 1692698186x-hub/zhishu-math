# 建议使用 http://127.0.0.1:8877/setup 填写
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 切换华为云时填写以下配置并设置 AI_PROVIDER=maas
MAAS_API_KEY=
MAAS_MODEL=
MAAS_CHAT_URL=https://api.modelarts-maas.com/v2/chat/completions
HOST=127.0.0.1
PORT=8877
# 云端部署通过环境变量注入 DCS Redis 配置，本机不必填写。
REDIS_URL=
REDIS_PREFIX=zhishu:{learning}
REDIS_CA_FILE=
