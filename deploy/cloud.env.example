# Copy to deploy/.env.cloud and fill it only on the deployment host.
AI_PROVIDER=maas
MAAS_API_KEY=
MAAS_MODEL=
MAAS_CHAT_URL=https://api.modelarts-maas.com/v2/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Use the private address of your DCS instance in the same region and VPC.
# Prefer rediss:// when TLS is enabled. URL-encode the password.
REDIS_URL=
REDIS_PREFIX=zhishu:{learning}
REDIS_CA_FILE=

# Only needed for the optional public HTTPS demo profile.
ZHISHU_PUBLIC_DOMAIN=
ZHISHU_DEMO_USER=
ZHISHU_DEMO_PASSWORD_HASH=
